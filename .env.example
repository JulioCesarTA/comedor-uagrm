# ============================================================
# Comedor UAGRM — variables de entorno locales
# Copiar a `.env` antes de `docker compose up`
# ============================================================

# ---------- MongoDB (menu-inventario-service) ----------
MONGO_INITDB_ROOT_USERNAME=comedor
MONGO_INITDB_ROOT_PASSWORD=comedor123
MONGO_DB_MENU=menu_inventario

# ---------- PostgreSQL — comensales/reservas (Azure sim) ----------
POSTGRES_COMENSALES_USER=comensales
POSTGRES_COMENSALES_PASSWORD=comensales123
POSTGRES_COMENSALES_DB=comensales_reservas

# ---------- PostgreSQL — pagos/tickets (GCP sim) ----------
POSTGRES_PAGOS_USER=pagos
POSTGRES_PAGOS_PASSWORD=pagos123
POSTGRES_PAGOS_DB=pagos_tickets

# ---------- PostgreSQL — read model CQRS (AWS sim) ----------
POSTGRES_CQRS_USER=cqrs
POSTGRES_CQRS_PASSWORD=cqrs123
POSTGRES_CQRS_DB=cqrs_read

# ---------- LocalStack (AWS sim: SNS/SQS/S3) ----------
LOCALSTACK_SERVICES=sns,sqs,s3,dynamodb
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# ---------- DynamoDB Local ----------
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_TABLE_IDEMPOTENCY=idempotency_keys
DYNAMODB_TABLE_SAGAS=sagas

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=comedor-uagrm
KEYCLOAK_URL=http://keycloak:8080

# ---------- n8n ----------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_HOST=localhost
N8N_PORT=5678

# ---------- Microservicios (puertos externos) ----------
PORT_MENU_INVENTARIO=8081
PORT_COMENSALES_RESERVAS=8082
PORT_PAGOS_TICKETS=8083
PORT_IA_ML=8084
PORT_API_GATEWAY=8080
PORT_GRAPHQL_GATEWAY=8090

# ---------- Frontends ----------
PORT_SHELL=3000
PORT_BACKOFFICE=3001
PORT_PORTAL_ESTUDIANTE=3002
PORT_INTELIGENCIA_NEGOCIO=3003
TELEGRAM_RECEPCION=n8n  # n8n recibe/responde Telegram (pon 'interna' para que lo haga ia-ml solo)
